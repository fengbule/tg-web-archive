ADMIN_PASSWORD_PBKDF2=由scripts/manage.sh自动生成
# 兼容旧部署：ADMIN_PASSWORD_HASH_B64=Base64编码后的bcrypt哈希
SESSION_SECRET=请使用openssl-rand-hex-32生成
CONFIG_ENCRYPTION_KEY=请使用Fernet密钥
DATA_ROOT=/data/telegram-video-manager
MIN_FREE_GB=10
DOWNLOAD_CONCURRENCY=2
# 每文件并行请求 / 每账号额外跨 DC 文件连接，范围 1–4
DOWNLOAD_PARTS=4
DOWNLOAD_CONNECTIONS=4
USE_X_ACCEL=true
COOKIE_SECURE=false
# true = 后台自动为每个视频生成 480P 流畅版（单 worker，约占一个 CPU 核）
AUTO_SMOOTH=false
APP_VERSION=2.0.0
